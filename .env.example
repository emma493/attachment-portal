# FIREBASE - paste from Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# CLOUDINARY - from Cloudinary Console > Settings
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# EMAIL - set in Netlify dashboard, never in frontend
# Netlify > Site settings > Environment variables
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_PROVIDER=brevo
# GMAIL SMTP TEST-ONLY (spam-prone, 500/day). Use App Password, never commit real values.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Students: create-only, must force status == pending
    match /submissions/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.fullName is string
        && request.resource.data.email is string;
      // Only signed-in admins read/update (restrict further via custom claims or UID check)
      allow read, update: if request.auth != null;
      allow delete: if false;
    }
    // Daily reference counters: anyone may read a day's number and bump it
    // by exactly 1 (first creation starts at 1). No listing, no other writes.
    match /refCounters/{day} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
  }
}
